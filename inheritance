const std = @import("std");

const inherits = {abstract, parent};

const Inheritance = union(inherits) {
	is_abstract:bool,
  parent:Instance,

  pub fn setField(self:Inheritance, fields:anytype) void {
		var data:[_][]const u8 = undefined;
		for(fields) |field| {
			//mise a jour des donnees pfield
			data[data.len] = field;
	  }
		self.parent.fields = @as([][]const u8, data);
	}

	pub fn setFieldsValue(self:Inheritance, fvalue:anytype) void {
		var i=0;
		var data:[_][]const u8 = undefined;
		for(fvalue) |value| {
			//mise a jour des donnees values
			data[i] = value; 
			i+=1;
		}
		self.parent.fieldsValue = @as([][]const u8, data);
	}

	pub fn setChildren(self:Inheritance, fvalue:anytype, parent:anytype, list: anytype) void {
		var i=0;
		var data:[_][]const u8 = undefined;
		for(fvalue, list) |value, obj| {
			//mise a jour des donnees values
			if(comptime std.meta.eql(@field(obj, "extends"), parent)) {
				data[i] = value;
			}
			i+=1;
		}
		self.parent.children = @as([][]const u8, data);
	}

  pub fn apply(self:Inheritance, instanceName:[]const u8, instanceValues:[][]const u8, list:anytype) @TypeOf(anytype) {
		var result:@TypeOf(anytype) = undefined;
		self.parent.instance_from_child = instanceName;
		const childInstance = getObjectByName(instanceName,list);
		setParentValue(getObjectByName(self.parent.name,list)[0], instanceValues);
		result[0] = getObjectByName(self.parent.name,list)[0];
		result[1] = childInstance;
		return result;
	}
}

fn setParentValue(parent:anytype, values:anytype) void {
	for(@typeInfo(parent).fields, fvalue) |fparent, value| {
		@field(parent, fparent) = value;
	}
}

fn getObjectByName(name:[]const u8, list:anytype) @TypeOf(anytype) {

	var result:?@TypeOf(anytype) = undefined;
	for(list) |obj| {
		if(std.mem.eqlBytes(@typeName(obj), name)) {
			result[0] = obj;
			return result;
		}
	}
  return null;
} 

const Instance = union {
  name:[]const u8,
	fields:[][]const u8,
  fieldsValue:[][]const u8,
	children:[][]const u8,
  instance_from_child:[]const u8,
}